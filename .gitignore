# =============================================================================
# Shiori Repo - .gitignore
# =============================================================================
# This file is tailored for the Shiori Repository.
# Organized into: Python, Project-Specific, Editor/IDE, and OS sections.
# =============================================================================


# -----------------------------------------------------------------------------
# PYTHON - Standard artifacts from Python development
# -----------------------------------------------------------------------------

# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (use .venv/ locally)
.venv/
venv/
env/

# Distribution / packaging (PyInstaller outputs go to dist/)
build/
dist/
*.egg-info/
*.egg

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checker caches
.mypy_cache/
.ruff_cache/

# Installer logs
pip-log.txt


# -----------------------------------------------------------------------------
# PROJECT-SPECIFIC - Bot runtime files and local configuration
# -----------------------------------------------------------------------------

# Secrets - NEVER commit (contains bot token, API keys, etc.)
*.env

# Database files (created at runtime via config.APP_PATH)
*.db
*.db.backup

# Runtime directories (logs, cache, music downloads)
/logs/
/cache/

# Implementation notes / local dev docs (not part of source)
/Impls/

# Asset config files - commit the .example templates, not actual configs
# Users copy *.toml.example → *.toml and customize locally
*.toml
!*.toml.example

# Web build artifacts (regenerate: npx tailwindcss -i input.css -o tailwind.css --minify)
assets/web/tailwind.css

# Dev mock data module (create your own for local web UI testing)
utils/web/mock_data.py

# Backup files from manual edits
*.py.backup

# Deployment helpers (local Windows scripts, rsync filters)
*.bat
deploy-filter.txt

# Temporary shelved files
search_old.py


# -----------------------------------------------------------------------------
# EDITORS / IDEs
# -----------------------------------------------------------------------------

# VS Code - workspace settings are personal preference
.vscode/

# JetBrains (PyCharm, etc.)
.idea/

# -----------------------------------------------------------------------------
# OS-SPECIFIC
# -----------------------------------------------------------------------------

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini